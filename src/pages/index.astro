---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Proof from '../components/Proof.astro';
import WhyUs from '../components/WhyUs.astro';
import Process from '../components/Process.astro';
import Roi from '../components/Roi.astro';
import LeadMagnet from '../components/LeadMagnet.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
---
<!-- Section surfaces alternate deliberately so no two neighbours share a
     ground: gradient → navy → abyss → navy → deep → navy → abyss → navy → deep. -->
<BaseLayout includeFaqSchema={true}>
  <Hero />
  <Services />
  <Proof />
  <WhyUs />
  <Process />
  <Roi />
  <LeadMagnet />
  <FAQ />
  <CTA />
</BaseLayout>
