---
// Hero centrepiece: a glowing light ribbon sweeping under the headline.
// Inline SVG + CSS keyframes only. Like the GridBeams background it replaced,
// it sits in the LCP section, so it must never become a React island.
// The sway is transform-only (composited) and is zeroed by the global
// prefers-reduced-motion rule in global.css.
---
<div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
  <!-- Ambient blooms: a faint blue glow behind the headline, a brighter one
       where the ribbon crosses. -->
  <div class="absolute -top-40 left-1/2 h-[34rem] w-[52rem] -translate-x-1/2 rounded-full bg-brand-blue/20 blur-3xl"></div>
  <div class="absolute bottom-0 left-1/2 h-[24rem] w-[70rem] -translate-x-1/2 translate-y-1/3 rounded-full bg-brand-cyan/10 blur-3xl"></div>

  <svg
    class="absolute inset-x-[-10%] bottom-[-6%] h-[62%] w-[120%] min-h-[18rem]"
    viewBox="0 0 1600 600"
    preserveAspectRatio="xMidYMid slice"
    fill="none"
  >
    <defs>
      <linearGradient id="ribbon-sheet" x1="0" y1="0" x2="1600" y2="0" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#0077B6" stop-opacity="0.05" />
        <stop offset="0.3" stop-color="#0077B6" stop-opacity="0.55" />
        <stop offset="0.55" stop-color="#00D2FF" stop-opacity="0.35" />
        <stop offset="1" stop-color="#0077B6" stop-opacity="0.05" />
      </linearGradient>
      <linearGradient id="ribbon-edge" x1="0" y1="0" x2="1600" y2="0" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#0077B6" stop-opacity="0" />
        <stop offset="0.25" stop-color="#00D2FF" />
        <stop offset="0.6" stop-color="#00E5FF" />
        <stop offset="1" stop-color="#0077B6" stop-opacity="0" />
      </linearGradient>
      <filter id="ribbon-blur" x="-10%" y="-50%" width="120%" height="200%">
        <feGaussianBlur stdDeviation="18" />
      </filter>
      <filter id="ribbon-glow" x="-10%" y="-50%" width="120%" height="200%">
        <feGaussianBlur stdDeviation="6" />
      </filter>
    </defs>

    <!-- Main sweep: a translucent sheet with a lit leading edge. -->
    <g class="origin-center [transform-box:fill-box] animate-ribbon-drift">
      <path
        d="M-40 470 C 260 250, 560 180, 820 300 S 1300 470, 1660 210 L 1660 300 C 1320 520, 1040 470, 820 380 S 300 360, -40 560 Z"
        fill="url(#ribbon-sheet)"
        filter="url(#ribbon-blur)"
      />
      <path
        d="M-40 470 C 260 250, 560 180, 820 300 S 1300 470, 1660 210"
        stroke="url(#ribbon-edge)"
        stroke-width="10"
        filter="url(#ribbon-glow)"
        opacity="0.7"
      />
      <path
        d="M-40 470 C 260 250, 560 180, 820 300 S 1300 470, 1660 210"
        stroke="url(#ribbon-edge)"
        stroke-width="2"
      />
    </g>

    <!-- Counter sweep: thinner, drifting the other way for depth. -->
    <g class="origin-center [transform-box:fill-box] animate-ribbon-drift [animation-direction:alternate-reverse] [animation-duration:18s]">
      <path
        d="M-40 300 C 300 520, 700 540, 980 380 S 1400 160, 1660 330"
        stroke="url(#ribbon-edge)"
        stroke-width="8"
        filter="url(#ribbon-glow)"
        opacity="0.45"
      />
      <path
        d="M-40 300 C 300 520, 700 540, 980 380 S 1400 160, 1660 330"
        stroke="url(#ribbon-edge)"
        stroke-width="1.5"
        opacity="0.8"
      />
    </g>
  </svg>

  <!-- Bottom fade into the platform strip and the abyss-coloured Leaks section. -->
  <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-b from-transparent to-brand-abyss"></div>
</div>
