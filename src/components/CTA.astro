---
import Icon from './Icon.astro';
import { finalCta } from '../data/site';
---
<section class="section bg-white">
  <div class="container">
    <div class="relative overflow-hidden rounded-3xl bg-hero-gradient text-white px-8 py-14 lg:px-16 lg:py-20 text-center">
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="absolute -top-16 -right-16 w-72 h-72 rounded-full bg-brand-cyan/20 blur-3xl"></div>
        <div class="absolute -bottom-16 -left-16 w-72 h-72 rounded-full bg-brand-blue/20 blur-3xl"></div>
      </div>
      <div class="relative max-w-2xl mx-auto">
        <h2 class="text-3xl lg:text-4xl font-bold text-white">{finalCta.title}</h2>
        <p class="mt-4 text-lg text-slate-200 leading-relaxed">{finalCta.subtitle}</p>
        <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center">
          <a href={finalCta.primaryCta.href} class="btn-primary">
            {finalCta.primaryCta.label}
            <Icon name="arrow" class="w-5 h-5" />
          </a>
          <a href={finalCta.secondaryCta.href} class="btn-secondary">{finalCta.secondaryCta.label}</a>
        </div>
      </div>
    </div>
  </div>
</section>
