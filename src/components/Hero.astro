---
import Icon from './Icon.astro';
import AccentTitle from './AccentTitle.astro';
import HeroRibbon from './HeroRibbon.astro';
import { hero, proof } from '../data/site';

// Ticker is duplicated once; the CSS animation translates the track by exactly
// -50%, so the second half lands where the first started. aria-hidden on the
// clone keeps screen readers from reading the list twice.
const tickerHalves = [false, true];
---
<!-- Centered single column over a code-drawn light ribbon. min-h uses dvh minus
     the fixed header so the hero fills the viewport without the iOS
     address-bar jump h-screen causes. -->
<section
  class="relative flex flex-col overflow-hidden bg-hero-gradient text-white
         min-h-[calc(100dvh-4rem)] lg:min-h-[calc(100dvh-5rem)]"
>
  <HeroRibbon />

  <div class="container relative flex flex-1 flex-col items-center pt-14 text-center lg:pt-20">
    <p class="badge-split">
      <span class="badge-split-chip">{hero.eyebrowTag}</span>
      {hero.eyebrow}
    </p>

    <h1
      class="mt-7 max-w-4xl text-[2.375rem] font-semibold leading-[1.06] tracking-[-0.03em] text-white sm:text-5xl lg:text-6xl xl:text-[4.25rem]"
    >
      <AccentTitle text={hero.title} accent={hero.accent} gradient />
    </h1>

    <p
      class="mt-6 max-w-[46ch] text-lg leading-relaxed text-slate-300 xl:text-xl"
    >
      {hero.subtitle}
    </p>

    <div
      class="mt-9 flex w-full flex-col items-center gap-4 sm:w-auto sm:flex-row sm:gap-7"
    >
      <span class="magnetic inline-flex w-full sm:w-auto">
        <a href={hero.primaryCta.href} class="btn-primary w-full sm:w-auto">
          {hero.primaryCta.label}
          <Icon name="arrow" class="h-5 w-5" />
        </a>
      </span>
      <a
        href={hero.secondaryCta.href}
        class="group inline-flex min-h-11 items-center gap-1.5 px-1 py-2.5 font-ui font-semibold text-white/80 transition-colors hover:text-white"
      >
        {hero.secondaryCta.label}
        <Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
      </a>
    </div>

    <!-- Who it is for, by trade, so a visitor can self-select at a glance. -->
    <p class="mt-8 max-w-2xl text-balance font-ui text-sm leading-relaxed text-slate-400">
      {hero.audience}
    </p>

    <!-- Trust row: icon tiles split by hairline dividers, Equinox-style. -->
    <ul
      class="mt-8 flex flex-col items-center gap-4 font-ui text-sm text-slate-300 sm:flex-row sm:flex-wrap sm:items-center sm:justify-center sm:gap-0 sm:divide-x sm:divide-white/10 lg:mt-14"
    >
      {hero.trustSignals.map((signal) => (
        <li class="flex items-center gap-3 sm:px-6">
          <span class="inline-grid h-8 w-8 shrink-0 place-items-center rounded-lg border border-white/10 bg-white/[0.05] text-brand-cyan backdrop-blur-sm">
            <Icon name={signal.icon} class="h-4 w-4" />
          </span>
          {signal.label}
        </li>
      ))}
    </ul>

    <!-- Room for the ribbon to sweep below the copy. -->
    <div class="h-[clamp(3rem,7vw,6rem)] shrink-0" aria-hidden="true"></div>
  </div>

  <!-- Platform strip: tools we work in, never client logos (see CLAUDE.md).
       Pure CSS marquee, zero JavaScript. -->
  <div class="relative border-t border-white/10 bg-brand-abyss/50 backdrop-blur-md">
    <div class="container flex flex-col items-center gap-4 py-6 lg:flex-row lg:gap-10">
      <p class="shrink-0 text-center font-ui text-xs leading-snug text-slate-400 lg:max-w-[11rem] lg:text-left">
        Built on the platforms you already use
      </p>
      <div
        class="relative flex w-full overflow-hidden"
        style="mask-image: linear-gradient(to right, transparent, #000 10%, #000 90%, transparent); -webkit-mask-image: linear-gradient(to right, transparent, #000 10%, #000 90%, transparent);"
      >
        <div class="marquee-track flex w-max animate-marquee">
          {tickerHalves.map((isClone) => (
            <ul class="flex shrink-0 items-center gap-10 pr-10" aria-hidden={isClone ? 'true' : undefined}>
              {proof.ticker.map((item) => (
                <li class="whitespace-nowrap font-heading text-base font-semibold tracking-tight text-white/70">
                  {item}
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
