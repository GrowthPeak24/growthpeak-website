---
import LaunchRoadmap from './ui/launch-roadmap.tsx';
import { process } from '../data/site';
---
<section id="process" class="section bg-brand-deep scroll-mt-24">
  <div class="container">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <h2 class="section-title lg:col-span-6" data-reveal data-reveal-index="0">
        {process.title}
      </h2>
      <p class="section-lede mt-0 lg:col-span-6 lg:mb-1" data-reveal data-reveal-index="1">
        {process.subtitle}
      </p>
    </div>

    <!-- Expandable phases. Below the fold, so client:visible per the island
         rules in CLAUDE.md. -->
    <div class="mt-14" data-reveal data-reveal-index="2">
      <LaunchRoadmap steps={process.steps} client:visible />
    </div>
  </div>
</section>
