---
import { process } from '../data/site';
---
<section id="process" class="section bg-brand-light scroll-mt-24">
  <div class="container">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <h2 class="section-title lg:col-span-6" data-reveal data-reveal-index="0">
        {process.title}
      </h2>
      <p class="section-lede mt-0 lg:col-span-6 lg:mb-1" data-reveal data-reveal-index="1">
        {process.subtitle}
      </p>
    </div>

    <!-- Verb-first labels carry the hierarchy. A single rule ties the steps
         together in place of numbered badges. -->
    <ol class="mt-14 grid gap-y-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-x-8">
      {process.steps.map((step, i) => (
        <li class="relative pt-8" data-reveal data-reveal-index={i}>
          <span class="absolute inset-x-0 top-0 h-px bg-slate-300/70" aria-hidden="true"></span>
          <span class="absolute left-0 top-0 h-px w-12 bg-brand-blue" aria-hidden="true"></span>
          <h3 class="font-heading text-2xl font-extrabold tracking-tight lg:text-3xl">
            {step.title}
          </h3>
          <p class="mt-3 leading-relaxed text-slate-600">{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
