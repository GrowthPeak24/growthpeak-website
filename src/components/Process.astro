---
import Icon from './Icon.astro';
import LaunchRoadmap from './ui/launch-roadmap.tsx';
import AccentTitle from './AccentTitle.astro';
import { process } from '../data/site';
---
<section id="process" class="section bg-brand-deep scroll-mt-24">
  <div class="container">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <h2 class="section-title lg:col-span-6" data-reveal data-reveal-index="0">
        <AccentTitle text={process.title} accent={process.accent} />
      </h2>
      <p class="section-lede mt-0 lg:col-span-6 lg:mb-1" data-reveal data-reveal-index="1">
        {process.subtitle}
      </p>
    </div>

    <!-- Expandable phases. Below the fold, so client:visible per the island
         rules in CLAUDE.md. -->
    <div class="mt-14" data-reveal data-reveal-index="2">
      <LaunchRoadmap steps={process.steps} client:visible />
    </div>

    <div class="mx-auto mt-12 flex max-w-2xl flex-col items-center gap-5 text-center" data-reveal data-reveal-index="3">
      <p class="text-lg leading-relaxed text-slate-300">{process.cta.text}</p>
      <span class="magnetic inline-flex">
        <a href={process.cta.href} class="btn-primary">
          {process.cta.label}
          <Icon name="arrow" class="h-5 w-5" />
        </a>
      </span>
    </div>
  </div>
</section>
