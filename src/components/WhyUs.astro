---
import Icon from './Icon.astro';
import { whyUs } from '../data/site';
---
<section id="why-us" class="section bg-white scroll-mt-24">
  <div class="container">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <!-- Sticky-free asymmetric header column -->
      <div class="lg:col-span-5">
        <h2 class="section-title" data-reveal data-reveal-index="0">{whyUs.title}</h2>
        <p class="section-lede" data-reveal data-reveal-index="1">{whyUs.subtitle}</p>
      </div>

      <!-- 2x2 grid built from rules and whitespace, no icon-in-circle tiles. -->
      <div class="lg:col-span-7">
        <div class="grid gap-x-12 gap-y-10 sm:grid-cols-2">
          {whyUs.points.map((point, i) => (
            <div class="border-t border-slate-200 pt-6" data-reveal data-reveal-index={i}>
              <h3 class="flex items-center gap-3 text-lg font-bold leading-tight">
                <Icon name={point.icon} class="h-5 w-5 shrink-0 text-brand-blue" />
                {point.title}
              </h3>
              <p class="mt-3 leading-relaxed text-slate-600">{point.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
