---
import Icon from './Icon.astro';
import AccentTitle from './AccentTitle.astro';
import MetricCounters from './ui/metric-counter.tsx';
import { proof } from '../data/site';
---
<section id="proof" class="section relative scroll-mt-24 bg-brand-abyss">
  <div class="container relative">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="section-title" data-reveal data-reveal-index="0"><AccentTitle text={proof.title} accent={proof.accent} /></h2>
      <p class="section-lede mx-auto text-center" data-reveal data-reveal-index="1">
        {proof.subtitle}
      </p>
    </div>

    <div class="mt-14" data-reveal data-reveal-index="2">
      <MetricCounters metrics={proof.metrics} client:visible />
    </div>
    <!-- Operational guarantees: concrete deliverables we control, standing in
         for the social proof this site deliberately does not fake. -->
    <div class="mt-16 border-t border-white/10 pt-14 lg:mt-20">
      <h3 class="text-center font-heading text-2xl font-semibold tracking-[-0.02em] text-white lg:text-3xl" data-reveal data-reveal-index="0">
        System &amp; Performance Guarantees
      </h3>
      <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {proof.deliverables.map((item, i) => (
          <li
            class="glass spotlight p-7 transition-colors duration-300 hover:border-brand-cyan/30"
            data-reveal
            data-reveal-index={i}
          >
            <span class="icon-tile">
              <Icon name={item.icon} class="h-5 w-5" />
            </span>
            <h4 class="mt-5 font-heading text-base font-semibold leading-snug text-white">
              {item.title}
            </h4>
            <p class="mt-2 text-sm leading-relaxed text-slate-400">{item.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
