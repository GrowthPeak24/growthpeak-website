---
interface Props {
  class?: string;
  variant?: 'light' | 'dark';
  /** Light variant only: the full stacked logo (footer) instead of the
   *  mark-plus-wordmark lockup (header), whose small size would shrink the
   *  stacked artwork's "DIGITAL" line to an unreadable few pixels. */
  stacked?: boolean;
}
const { class: className = '', variant = 'dark', stacked = false } = Astro.props;

// `dark` variant (default) = for light backgrounds → original artwork (public/assets/logo.png,
// opaque white ground). Nothing on the all-dark page uses it today; kept for any light surface.
// `light` variant = for dark backgrounds → artwork recolored for dark grounds from the
// transparent source in src/assets/brand/: wordmark white, "DIGITAL" brand cyan, the
// mountain's navy face lifted to brand blue so it doesn't vanish on navy.
---
{variant === 'dark' ? (
  <a
    href="/"
    class={`inline-flex items-center ${className}`}
    aria-label="GrowthPeak Digital home"
  >
    <img src="/assets/logo.png" alt="GrowthPeak Digital" class="h-11 lg:h-12 w-auto" width="600" height="435" />
  </a>
) : stacked ? (
  <a
    href="/"
    class={`inline-flex items-center ${className}`}
    aria-label="GrowthPeak Digital home"
  >
    <img src="/assets/logo-light.png" alt="GrowthPeak Digital" class="h-auto w-44" width="440" height="318" loading="lazy" decoding="async" />
  </a>
) : (
  <a
    href="/"
    class={`inline-flex items-center gap-2.5 ${className}`}
    aria-label="GrowthPeak Digital home"
  >
    <img src="/assets/logo-mark-light.png" alt="" class="h-8 w-auto lg:h-9" width="182" height="144" />
    <span class="whitespace-nowrap font-heading text-[1.0625rem] font-semibold tracking-[-0.02em] text-white lg:text-lg" aria-hidden="true">
      GrowthPeak <span class="text-brand-cyan">Digital</span>
    </span>
  </a>
)}
