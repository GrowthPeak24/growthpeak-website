---
import Icon from './Icon.astro';
import { services } from '../data/site';

const [lead, ...rest] = services.items;
---
<section id="services" class="section bg-white scroll-mt-24">
  <div class="container">
    <!-- Header sits left with the lede beside it, not stacked and centred. -->
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <h2 class="section-title lg:col-span-7" data-reveal data-reveal-index="0">
        {services.title}
      </h2>
      <p class="section-lede mt-0 lg:col-span-5 lg:mb-1" data-reveal data-reveal-index="1">
        {services.subtitle}
      </p>
    </div>

    <!-- Bento: one wide lead tile, two supporting tiles beneath it. -->
    <div class="mt-14 grid gap-5 lg:grid-cols-12">
      <article
        class="spotlight group relative overflow-hidden rounded-2xl border border-slate-200 bg-brand-light p-8 lg:col-span-12 lg:p-10"
        data-reveal
        data-reveal-index="0"
      >
        <div class="grid gap-8 lg:grid-cols-12 lg:items-start">
          <div class="lg:col-span-6">
            <Icon name={lead.icon} class="h-8 w-8 text-brand-blue" />
            <h3 class="mt-5 text-2xl font-bold lg:text-3xl">{lead.name}</h3>
            <p class="mt-3 max-w-[46ch] leading-relaxed text-slate-600">{lead.blurb}</p>
          </div>
          <ul class="grid gap-3 sm:grid-cols-2 lg:col-span-6 lg:mt-2">
            {lead.bullets.map((bullet) => (
              <li class="flex items-start gap-2.5 text-sm text-slate-700">
                <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-brand-green" />
                <span>{bullet}</span>
              </li>
            ))}
          </ul>
        </div>
      </article>

      {rest.map((service, i) => (
        <article
          class="spotlight group relative overflow-hidden rounded-2xl border border-slate-200 bg-white p-8 transition-colors duration-300 hover:border-brand-blue/40 lg:col-span-6"
          data-reveal
          data-reveal-index={i + 1}
        >
          <Icon name={service.icon} class="h-8 w-8 text-brand-blue" />
          <h3 class="mt-5 text-xl font-bold">{service.name}</h3>
          <p class="mt-3 leading-relaxed text-slate-600">{service.blurb}</p>
          <ul class="mt-6 space-y-2.5 border-t border-slate-100 pt-6">
            {service.bullets.map((bullet) => (
              <li class="flex items-start gap-2.5 text-sm text-slate-700">
                <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-brand-green" />
                <span>{bullet}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
