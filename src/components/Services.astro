---
import BentoGrid from './ui/bento-grid.tsx';
import { services } from '../data/site';
---
<section id="services" class="section relative scroll-mt-24 bg-brand-navy">
  <div class="container relative">
    <!-- Header sits left with the lede beside it, not stacked and centred. -->
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <h2 class="section-title lg:col-span-7" data-reveal data-reveal-index="0">
        {services.title}
      </h2>
      <p class="section-lede mt-0 lg:col-span-5 lg:mb-1" data-reveal data-reveal-index="1">
        {services.subtitle}
      </p>
    </div>

    <!-- Bento grid is interactive (cursor-tracked border glow), so it hydrates
         on visibility rather than on load. -->
    <div class="mt-14" data-reveal data-reveal-index="2">
      <BentoGrid items={services.items} client:visible />
    </div>
  </div>
</section>
