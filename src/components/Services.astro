---
import Icon from './Icon.astro';
import { services } from '../data/site';
---
<section id="services" class="section bg-white scroll-mt-20">
  <div class="container">
    <div class="max-w-2xl mx-auto text-center">
      <p class="eyebrow">{services.eyebrow}</p>
      <h2 class="mt-3 text-3xl lg:text-4xl font-bold">{services.title}</h2>
      <p class="mt-4 text-slate-600 text-lg leading-relaxed">{services.subtitle}</p>
    </div>

    <div class="mt-14 grid gap-8 md:grid-cols-3">
      {services.items.map((service) => (
        <article class="group relative rounded-2xl border border-slate-100 bg-white p-8 shadow-card hover:shadow-card-hover hover:-translate-y-1 transition-all duration-300">
          <div class="grid place-items-center w-14 h-14 rounded-xl bg-brand-gradient text-white">
            <Icon name={service.icon} class="w-7 h-7" />
          </div>
          <h3 class="mt-6 text-xl font-bold">{service.name}</h3>
          <p class="mt-3 text-slate-600 leading-relaxed">{service.blurb}</p>
          <ul class="mt-5 space-y-2.5">
            {service.bullets.map((bullet) => (
              <li class="flex items-start gap-2.5 text-sm text-slate-700">
                <Icon name="check" class="w-5 h-5 text-brand-green shrink-0 mt-0.5" />
                <span>{bullet}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
