---
import { faq } from '../data/site';
---
<section id="faq" class="section bg-white scroll-mt-24">
  <div class="container">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <h2 class="section-title" data-reveal data-reveal-index="0">{faq.title}</h2>
        <p class="section-lede" data-reveal data-reveal-index="1">{faq.subtitle}</p>
      </div>

      <!-- Flat accordion: hairline dividers instead of stacked cards. -->
      <div class="lg:col-span-7">
        <div class="border-t border-slate-200">
          {faq.items.map((item, i) => (
            <details
              class="group border-b border-slate-200"
              open={i === 0}
              data-reveal
              data-reveal-index={i}
            >
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 font-ui text-base font-semibold text-brand-navy transition-colors hover:text-brand-blue">
                <span>{item.q}</span>
                <span
                  class="mt-1 grid h-5 w-5 shrink-0 place-items-center text-brand-blue transition-transform duration-300 group-open:rotate-45"
                  aria-hidden="true"
                >
                  <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                    <line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" />
                  </svg>
                </span>
              </summary>
              <div class="max-w-[64ch] pb-6 pr-8 leading-relaxed text-slate-600">
                {item.a}
              </div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
