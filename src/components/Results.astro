---
import { results } from '../data/site';

// TODO(mock data): every number rendered here is illustrative, not a verified
// client result. Publishing invented performance claims is a legal risk.
// Replace with real, documented figures or remove <Results /> from
// src/pages/index.astro before this site goes live.
---
<section id="results" class="section bg-brand-light scroll-mt-24">
  <div class="container">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <h2 class="section-title lg:col-span-6" data-reveal data-reveal-index="0">
        {results.title}
      </h2>
      <p class="section-lede mt-0 lg:col-span-6 lg:mb-1" data-reveal data-reveal-index="1">
        {results.subtitle}
      </p>
    </div>

    <!-- Numbers breathe in plain layout: dividers, not card containers. -->
    <ul class="mt-14 grid gap-y-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-x-10">
      {results.stats.map((stat, i) => (
        <li
          class="border-t border-slate-300/70 pt-6 lg:border-l lg:border-t-0 lg:pl-8 lg:pt-0 lg:first:border-l-0 lg:first:pl-0"
          data-reveal
          data-reveal-index={i}
        >
          <p class="font-heading text-5xl font-extrabold leading-none tracking-tight text-brand-navy lg:text-6xl">
            {stat.value}
          </p>
          <p class="mt-4 font-ui text-sm font-semibold text-brand-blue">{stat.label}</p>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">{stat.detail}</p>
        </li>
      ))}
    </ul>

    <div class="mt-16 grid gap-5 lg:grid-cols-2">
      {results.cases.map((item, i) => (
        <article
          class="spotlight rounded-2xl border border-slate-200 bg-white p-8 lg:p-9"
          data-reveal
          data-reveal-index={i}
        >
          <p class="font-ui text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">
            {item.industry}
          </p>
          <h3 class="mt-4 text-xl font-bold leading-snug lg:text-2xl">{item.headline}</h3>
          <p class="mt-3 leading-relaxed text-slate-600">{item.text}</p>
          <p class="mt-7 flex items-baseline gap-3 border-t border-slate-100 pt-6">
            <span class="font-heading text-3xl font-extrabold tracking-tight text-brand-blue">
              {item.metric}
            </span>
            <span class="font-ui text-sm text-slate-500">{item.metricLabel}</span>
          </p>
        </article>
      ))}
    </div>

    <p class="mt-8 font-ui text-xs text-slate-500">{results.disclaimer}</p>
  </div>
</section>
