---
import Icon from './Icon.astro';
import RoiEstimator from './ui/roi-estimator.tsx';
import AccentTitle from './AccentTitle.astro';
import { proof } from '../data/site';
---
<section id="roi" class="section relative scroll-mt-24 bg-brand-navy">
  <!-- Ambient cyan bloom, matched to the hero so the page reads as one surface. -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="absolute left-1/2 top-0 h-[26rem] w-[46rem] -translate-x-1/2 rounded-full bg-brand-blue/10 blur-3xl"></div>
  </div>

  <div class="container relative">
    <div class="max-w-2xl sm:mx-auto sm:text-center">
      <h2 class="section-title" data-reveal data-reveal-index="0"><AccentTitle text={proof.roi.title} accent={proof.roi.accent} /></h2>
      <p class="section-lede sm:mx-auto" data-reveal data-reveal-index="1">
        {proof.roi.subtitle}
      </p>
    </div>

    <div class="mt-12 lg:mt-14" data-reveal data-reveal-index="2">
      <RoiEstimator modelLabel={proof.roi.modelLabel} client:visible />
    </div>

    <!-- Next step right after the visitor sees what missed leads cost them.
         Same single CTA as the rest of the page; the estimator and its
         disclaimer above are untouched. -->
    <div class="mx-auto mt-10 flex max-w-2xl flex-col items-center gap-5 text-center" data-reveal data-reveal-index="3">
      <p class="text-lg leading-relaxed text-slate-300">{proof.roi.cta.text}</p>
      <span class="magnetic inline-flex">
        <a href={proof.roi.cta.href} class="btn-primary">
          {proof.roi.cta.label}
          <Icon name="arrow" class="h-5 w-5" />
        </a>
      </span>
    </div>
  </div>
</section>
